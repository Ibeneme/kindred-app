{
  "expo": {
    "name": "kokohor",
    "slug": "kokohor",
    "version": "7.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kokohor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kokohor.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["voip", "audio", "remote-notification"],
        "NSMicrophoneUsageDescription": "Kokohor needs microphone access for your family calls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kokohor.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Kokohor to access your microphone for calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://npzblfeflejcyclcopfi.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5wemJsZmVmbGVqY3ljbGNvcGZpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjcwMDgwNTQsImV4cCI6MjA4MjU4NDA1NH0.gsMilqRpVtYEd2Pj2ofPCQZiJOOMpCDY-8ucyvBsISk",
      "router": {},
      "eas": {
        "projectId": "bdb36e91-be76-4209-b212-02f9cf2e4558"
      }
    },
    "owner": "clonekraft-app"
  }
}
